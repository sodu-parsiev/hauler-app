{
  "manifest_version": 3,
  "name": "Hauler Helper",
  "version": "1.0.0",
  "description": "Open marketplace links in Hauler and access community tools directly.",
  "permissions": ["storage", "scripting", "activeTab", "clipboardWrite"],
  "host_permissions": [
    "*://1688.com/*",
    "*://*.1688.com/*",
    "*://taobao.com/*",
    "*://*.taobao.com/*",
    "*://tmall.com/*",
    "*://*.tmall.com/*",
    "*://weidian.com/*",
    "*://*.weidian.com/*",
    "*://acbuy.com/*",
    "*://*.acbuy.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://1688.com/*",
        "*://*.1688.com/*",
        "*://taobao.com/*",
        "*://*.taobao.com/*",
        "*://tmall.com/*",
        "*://*.tmall.com/*",
        "*://weidian.com/*",
        "*://*.weidian.com/*",
        "*://acbuy.com/*",
        "*://*.acbuy.com/*"
      ],
      "js": ["content.js"],
      "css": ["banner.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["welcome.html"],
      "matches": [
        "*://1688.com/*",
        "*://*.1688.com/*",
        "*://taobao.com/*",
        "*://*.taobao.com/*",
        "*://tmall.com/*",
        "*://*.tmall.com/*",
        "*://weidian.com/*",
        "*://*.weidian.com/*",
        "*://acbuy.com/*",
        "*://*.acbuy.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "Hauler Helper"
  }
}
